{
  "expo": {
    "name": "SEPL PO Status",
    "slug": "sepl-job-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sepl.jobtracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sepl.jobtracker"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "SEPL PO Status",
      "shortName": "SEPL PO Status",
      "themeColor": "#2E3192",
      "backgroundColor": "#FFFFFF",
      "display": "standalone",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "sepltracker",
    "experiments": {
      "baseUrl": "/sepl-job-tracker"
    }
  }
}
